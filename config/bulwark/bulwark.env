NODE_ENV=production
APP_NAME=Mail
JMAP_SERVER_URL=https://{{ .AppDomainName }}
STALWART_FEATURES=true
STALWART_ADMIN_ACCESS=auto
SESSION_SECRET_FILE={{ .DataDir }}/bulwark/session.secret
SETTINGS_SYNC_ENABLED=true
SETTINGS_DATA_DIR={{ .DataDir }}/bulwark/settings
ADMIN_CONFIG_DIR={{ .DataDir }}/bulwark/admin
ADMIN_STATE_DIR={{ .DataDir }}/bulwark/admin-state
TELEMETRY_DATA_DIR={{ .DataDir }}/bulwark/telemetry
BULWARK_TELEMETRY_DISABLED=1
BULWARK_UPDATE_CHECK=off
VERSION_CHECK_DATA_DIR={{ .DataDir }}/bulwark/version-check
LOG_FORMAT=text
BULWARK_SOCKET={{ .DataDir }}/bulwark.sock
BULWARK_JMAP_HOST={{ .AppDomainName }}
BULWARK_JMAP_SOCKET={{ .DataDir }}/stalwart.sock
OAUTH_ENABLED=true
OAUTH_ONLY=true
OAUTH_CLIENT_ID=mail
OAUTH_CLIENT_SECRET_FILE={{ .OauthSecretFile }}
OAUTH_ISSUER_URL={{ .AuthUrl }}
NODE_EXTRA_CA_CERTS={{ .PlatformCa }}
