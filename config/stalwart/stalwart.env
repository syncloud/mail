STALWART_HOSTNAME={{ .AppDomainName }}
STALWART_PUBLIC_URL=https://{{ .AppDomainName }}
STALWART_DIRECTORY_EMAIL_DOMAIN={{ .DeviceDomainName }}
STALWART_DIRECTORY_ADMIN_GROUP=syncloud@{{ .DeviceDomainName }}
STALWART_UNIX_LISTENERS=http={{ .DataDir }}/stalwart.sock,tunnel={{ .DataDir }}/spool/public/tunnel
STALWART_ADMIN_SOCKET={{ .DataDir }}/stalwart/admin.sock
RUN_AS_USER=mail
RUN_AS_GROUP=mail
SSL_CERT_FILE={{ .DataDir }}/stalwart/tls/ca.pem
STALWART_TOKEN_ISSUER={{ .AuthUrl }}
STALWART_TOKEN_CLIENT_ID=mail
STALWART_TOKEN_CLIENT_SECRET_FILE={{ .OauthSecretFile }}
